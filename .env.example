# DevGuard AI
APP_ENV=development
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default local mode. Docker overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./devguard.db

# AI provider: disabled | ollama | openai_compatible
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# CORS
FRONTEND_ORIGIN=http://localhost:5173
